# Postgres
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hovimestari
# Host-side port for psql/tooling. Container always listens on 5432 internally.
# Default 5001 avoids clashing with other dev Postgres instances on 5432.
POSTGRES_PORT=5001

# API
# The api container reads PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE,
# which compose derives from the POSTGRES_* values above.
API_PORT=3000
MIGRATE_ON_BOOT=true
CORS_ORIGIN=*

# Web
WEB_PORT=5173
VITE_API_BASE=/api

# LAN URL hints printed by the web dev server. Both are optional.
# macOS:  scutil --get LocalHostName            (then visit http://<that>.local:5173)
# Linux:  hostname                              (requires Avahi/mDNS on host)
#HOST_HOSTNAME=
# macOS:  ipconfig getifaddr en0
# Linux:  hostname -I | awk '{print $1}'
#HOST_LAN_IP=

# LLM providers (Phase 2). Leave both unset to disable AI features (route
# returns 503). If only one is set, it is used unconditionally. If both are
# set, local runs first and Anthropic is the fallback for parse failures or
# low confidence. HOVI_FORCE_PROVIDER overrides routing for debugging.
ANTHROPIC_API_KEY=
# Per-method model selection. Precedence: TEXT/VISION specific > ANTHROPIC_MODEL > defaults.
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6
# Legacy fallback used when the per-method vars above are unset. Leave commented unless pinning both.
#ANTHROPIC_MODEL=claude-sonnet-4-6
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Exact model ID as shown in LM Studio's Developer tab (e.g. "qwen/qwen3.5-9b").
# Recommended: a dense Qwen 8-14B for reliable Finnish structured output.
# Optional if only one model is loaded; required when multiple models are loaded
# so requests route to the intended one.
LMSTUDIO_MODEL=
HOVI_FORCE_PROVIDER=
