{
  "name": "@hovimestari/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=4096\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=4096\" jest --watch",
    "db:generate": "NODE_OPTIONS='--require tsx/cjs' drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS='--require tsx/cjs' drizzle-kit migrate",
    "db:studio": "NODE_OPTIONS='--require tsx/cjs' drizzle-kit studio",
    "fineli:import": "tsx src/scripts/fineliImport/index.ts",
    "fineli:recipe-counts": "tsx src/scripts/fineliImport/buildRecipeCounts.ts",
    "search:sample": "tsx src/services/__tests__/support/buildSearchSample.ts",
    "mcp:smoke": "tsx src/scripts/mcpSmoke/index.ts"
  },
  "dependencies": {
    "@hovimestari/types": "workspace:*",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
