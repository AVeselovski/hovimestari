      "checkConstraints": {
        "entries_status": {
          "name": "entries_status",
          "value": "\"entries\".\"status\" IN ('planned', 'eaten')"
        },
        "entries_kind": {
          "name": "entries_kind",
          "value": "\"entries\".\"kind\" IN ('food', 'saved_meal', 'estimate')"
        },
        "entries_eaten_at": {
          "name": "entries_eaten_at",
          "value": "(\"entries\".\"status\" = 'eaten') = (\"entries\".\"eaten_at\" IS NOT NULL)"
        },
        "entries_food": {
          "name": "entries_food",
          "value": "(\"entries\".\"kind\" = 'food') = (\"entries\".\"food_id\" IS NOT NULL AND \"entries\".\"grams\" IS NOT NULL)"
        },
        "entries_food_fields": {
          "name": "entries_food_fields",
          "value": "\"entries\".\"kind\" = 'food' OR (\"entries\".\"food_id\" IS NULL AND \"entries\".\"grams\" IS NULL AND \"entries\".\"portion_count\" IS NULL)"
        },
        "entries_meal": {
          "name": "entries_meal",
          "value": "(\"entries\".\"kind\" = 'saved_meal') = (\"entries\".\"saved_meal_id\" IS NOT NULL AND \"entries\".\"meal_count\" IS NOT NULL)"
        },
        "entries_meal_fields": {
          "name": "entries_meal_fields",
          "value": "\"entries\".\"kind\" = 'saved_meal' OR (\"entries\".\"saved_meal_id\" IS NULL AND \"entries\".\"meal_count\" IS NULL)"
        },
        "entries_estimate": {
          "name": "entries_estimate",
          "value": "(\"entries\".\"kind\" = 'estimate') = (\"entries\".\"name\" IS NOT NULL)"
        },
        "entries_note": {
          "name": "entries_note",
          "value": "\"entries\".\"note\" IS NULL OR \"entries\".\"kind\" = 'estimate'"
        },
        "entries_portion": {
          "name": "entries_portion",
          "value": "(\"entries\".\"portion_count\" IS NULL) = (\"entries\".\"portion_unit\" IS NULL AND \"entries\".\"portion_name\" IS NULL) AND (\"entries\".\"portion_unit\" IS NULL OR \"entries\".\"portion_name\" IS NULL) AND (\"entries\".\"portion_id\" IS NULL OR \"entries\".\"portion_count\" IS NOT NULL)"
        },
        "entries_amounts": {
          "name": "entries_amounts",
          "value": "(\"entries\".\"grams\" IS NULL OR \"entries\".\"grams\" > 0) AND (\"entries\".\"meal_count\" IS NULL OR \"entries\".\"meal_count\" > 0) AND (\"entries\".\"portion_count\" IS NULL OR \"entries\".\"portion_count\" > 0)"
        },
        "entries_basis": {
          "name": "entries_basis",
          "value": "\"entries\".\"basis_energy_kcal\" >= 0 AND \"entries\".\"basis_protein_g\" >= 0 AND \"entries\".\"basis_carbs_g\" >= 0 AND \"entries\".\"basis_fat_g\" >= 0"
        }
      },
