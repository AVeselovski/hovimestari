# Local development. `pnpm env:init` at the repository root copies this file
# to .env and fills every empty secret below with a generated value.
NODE_ENV=development
PORT=3001
# The compose database from `pnpm db:up`. Trust authentication, so no password.
DATABASE_URL=postgresql://postgres@localhost:5433/hovimestari
# Connections the backend holds open to Postgres. Defaults to 5.
DB_POOL_MAX=5

# Generated by pnpm env:init. Each is at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# The web server presents this on every relayed call. Generated by pnpm env:init,
# with the same value written to apps/web/.env.local.
BFF_SECRET=
# Only during a rotation: the value BFF_SECRET replaced. Steps in docs/setup/fly-backend.md.
BFF_SECRET_PREVIOUS=

# The web app's origin. Several may be given, comma separated. From a phone on
# the same network, add the web app at this machine's address.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Sign-in with Google. All four or none: Google is off while they are empty.
# Setup: docs/setup/google-sign-in.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_LINK_CALLBACK_URL=

# Mail through Resend. Empty in development writes each mail, reset links
# included, to the backend's console. Required in production.
# Setup: docs/setup/resend-email.md
RESEND_API_KEY=
EMAIL_FROM=
