    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
