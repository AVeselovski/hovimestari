# Local development. `pnpm env:init` at the repository root copies this file
# to .env.local and fills BFF_SECRET with the value it writes to the backend's
# .env, because the two must match.

# The backend API as the browser reaches it, with /api/v1. From a phone on
# the same network, this machine's address instead of localhost.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Hosts, besides localhost, the development server serves its own resources
# to, comma separated. This machine's network address lets a phone load the
# page. Development only.
NEXT_DEV_ORIGINS=

# Server only, never sent to the browser. The backend as this server reaches it.
BACKEND_URL=http://localhost:3001
# The relay secret this server presents on every relayed sign-in call.
BFF_SECRET=
